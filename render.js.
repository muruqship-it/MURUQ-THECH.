  function safeText(value) {
    return String(value ?? "").replace(/[&<>"']/g, ch => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[ch]));
  }

  window.MURUQ.renderCatalog = function renderCatalog() {
    const grid = document.getElementById("appGrid");
    const count = document.getElementById("catalogStatus");
    const empty = document.getElementById("emptyState");
    if (!grid) return;

    const term = (window.MURUQ.searchTerm || "").trim().toLowerCase();
    const filter = (window.MURUQ.activeFilter || "all").toLowerCase();
    const results = window.MURUQ.apps.filter(app => {
      const text = [app.name, app.category, app.publisher, app.description, app.price].join(" ").toLowerCase();
      return (!term || text.includes(term)) && (filter === "all" || app.category === filter || (filter === "android" && app.category === "android"));
    });

    grid.innerHTML = results.map(app => `
      <article class="app-card">
        <div class="card-head">
          <div class="app-icon" style="--icon-a:${safeText(app.colors[0])};--icon-b:${safeText(app.colors[1])}" aria-hidden="true">${safeText(app.icon)}</div>
          <span class="category-name">${safeText(app.category)}</span>
        </div>
        <div class="app-info">
          <h3>${safeText(app.name)}</h3>
          <div class="publisher">${safeText(app.publisher)}</div>
          <div class="app-description">${safeText(app.description)}</div>
        </div>
        <div class="card-foot">
          <span class="price-label ${/paid|premium|vary/i.test(app.price) ? "paid" : ""}">${safeText(app.price)}</span>
          <a class="download-link" href="${safeText(app.url)}" target="_blank" rel="noopener noreferrer">Visit official page ↗</a>
        </div>
      </article>`).join("");

    if (count) count.textContent = `${results.length} app${results.length === 1 ? "" : "s"} found`;
    if (empty) empty.hidden = results.length !== 0;
    grid.hidden = results.length === 0;
  };

  window.MURUQ.searchTerm = "";
  window.MURUQ.activeFilter = "all";
  document.addEventListener("DOMContentLoaded", window.MURUQ.renderCatalog);
})();
