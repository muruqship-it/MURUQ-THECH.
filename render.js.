    {
      name: "Android Developers",
      category: "tools",
      type: "Developer Tools",
      icon: "🤖",
      description: "Official Android development documentation and tools.",
      url: "https://developer.android.com/"
    }
  ];

  window.MURUQ.activeFilter = "all";
  window.MURUQ.searchTerm = "";

  window.MURUQ.escapeHTML = function (value) {
    return String(value).replace(/[&<>"']/g, function (character) {
      return {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      }[character];
    });
  };

  window.MURUQ.renderCatalog = function () {
    const grid = document.getElementById("appGrid");
    const count = document.getElementById("count");
    const empty = document.getElementById("emptyState");

    if (!grid) return;

    const term = window.MURUQ.searchTerm.toLowerCase();
    const filter = window.MURUQ.activeFilter;

    const results = window.MURUQ.apps.filter(function (app) {
      const matchesCategory =
        filter === "all" || app.category === filter;

      const searchable = (
        app.name + " " +
        app.description + " " +
        app.type + " " +
        app.category
      ).toLowerCase();

      return matchesCategory && searchable.includes(term);
    });

    grid.innerHTML = results.map(function (app) {
      return `
        <article class="app-card">
          <div class="app-top">
            <div class="app-icon">${window.MURUQ.escapeHTML(app.icon)}</div>
            <span class="app-category">${window.MURUQ.escapeHTML(app.type)}</span>
          </div>
          <h3 class="app-name">${window.MURUQ.escapeHTML(app.name)}</h3>
          <p class="app-description">${window.MURUQ.escapeHTML(app.description)}</p>
          <a class="download"
             href="${window.MURUQ.escapeHTML(app.url)}"
             target="_blank"
             rel="noopener noreferrer">
             Official download ↗
          </a>
        </article>
      `;
    }).join("");

    if (count) {
      count.textContent = results.length +
        (results.length === 1 ? " item" : " items");
    }

    if (empty) empty.hidden = results.length !== 0;
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", function () {
      window.MURUQ.renderCatalog();
    });
  } else {
    window.MURUQ.renderCatalog();
  }
})();
