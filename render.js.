window.MURUQ.activeFilter = window.MURUQ.activeFilter || "all";
window.MURUQ.searchTerm = window.MURUQ.searchTerm || "";

window.MURUQ.escapeHTML = function (value) {
  return String(value).replace(/[&<>"']/g, function (char) {
    return {
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    }[char];
  });
};

window.MURUQ.renderCatalog = function () {
  const grid = document.getElementById("appGrid");
  const count = document.getElementById("count");
  const empty = document.getElementById("emptyState");

  if (!grid) return;

  const term = window.MURUQ.searchTerm.toLowerCase();
  const filter = window.MURUQ.activeFilter;

  const apps = window.MURUQ.apps.filter(function (app) {
    const matchesFilter =
      filter === "all" || app.category === filter;

    const searchable =
      (app.name + " " + app.description + " " +
       app.type + " " + app.category).toLowerCase();

    return matchesFilter && searchable.includes(term);
  });

  grid.innerHTML = apps.map(function (app) {
    const name = window.MURUQ.escapeHTML(app.name);
    const type = window.MURUQ.escapeHTML(app.type);
    const description = window.MURUQ.escapeHTML(app.description);
    const icon = window.MURUQ.escapeHTML(app.icon);
    const url = window.MURUQ.escapeHTML(app.url);

    return `
      <article class="app-card">
        <div class="app-top">
          <div class="app-icon">${icon}</div>
          <span class="app-category">${type}</span>
        </div>
        <h3 class="app-name">${name}</h3>
        <p class="app-description">${description}</p>
        <a class="download"
           href="${url}"
           target="_blank"
           rel="noopener noreferrer">
          Official download ↗
        </a>
      </article>
    `;
  }).join("");

  if (count) {
    count.textContent = apps.length +
      (apps.length === 1 ? " item" : " items");
  }

  if (empty) {
    empty.hidden = apps.length !== 0;
  }
};

document.addEventListener("DOMContentLoaded", function () {
  window.MURUQ.renderCatalog();
});
