(function(){
  const categoryNames={android:'Android',games:'Games',pc:'PC Software',media:'Media',tools:'Tools'};
  function make(tag,className,text){const el=document.createElement(tag);if(className)el.className=className;if(text!==undefined)el.textContent=text;return el;}
  window.MURUQ.renderCatalog=function(){
    const grid=document.getElementById('appGrid'),count=document.getElementById('count'),empty=document.getElementById('emptyState');
    if(!grid||!count||!empty)return;
    const term=(window.MURUQ.searchTerm||'').trim().toLowerCase(),filter=window.MURUQ.activeFilter||'all';
    const found=window.MURUQ.apps.filter(app=>{
      const categoryOK=filter==='all'||app.category===filter;
      const text=[app.name,app.publisher,app.category,app.tags,app.description].join(' ').toLowerCase();
      return categoryOK&&(!term||text.includes(term));
    });
    grid.replaceChildren();
    found.forEach(app=>{
      const card=make('article','app-card');
      const head=make('div','card-head');
      const icon=make('div','app-icon',app.mark);icon.style.setProperty('--icon-a',app.colors[0]);icon.style.setProperty('--icon-b',app.colors[1]);
      const info=make('div','app-info');info.append(make('h3','',app.name),make('div','publisher',app.publisher));
      head.append(icon,info,make('span','free-badge','FREE'));
      const description=make('p','app-description',app.description);
      const foot=make('div','card-foot');foot.append(make('span','category-name',categoryNames[app.category]||app.category));
      const link=make('a','download-link','Official download ↗');link.href=app.url;link.target='_blank';link.rel='noopener noreferrer';link.setAttribute('aria-label','Open official download page for '+app.name);
      foot.append(link);card.append(head,description,foot);grid.append(card);
    });
    count.textContent=found.length+' '+(found.length===1?'app':'apps')+' found';
    grid.hidden=found.length===0;empty.hidden=found.length!==0;
  };
  document.addEventListener('DOMContentLoaded',()=>{
    const year=document.getElementById('year');if(year)year.textContent=new Date().getFullYear();
    window.MURUQ.renderCatalog();
  });
})();
