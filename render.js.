window.MURUQ.escapeHTML = function(value) {
  return String(value).replace(/[&<>"']/g, c => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#039;"
  })[c]);
};

window.MURUQ.renderCatalog = function() {
  const grid = document.getElementById("appGrid");
  const count = document.getElementById("count");
  const empty = document.getElementById("emptyState");

  if (!grid) return;

  const term = (window.MURUQ.searchTerm || "").toLowerCase();
  const filter = window.MURUQ.activeFilter || "all";
  const safe = window.MURUQ.escapeHTML;

  const results = window.MURUQ.apps.filter(app => {
    const matchesFilter =
      filter === "all" ||
      app.platform === filter ||
      app.category === filter;

    const text =
      `${app.name} ${app.description} ${app.platform} ${app.category} ${app.device}`
      .toLowerCase();

    return matchesFilter && text.includes(term);
  });

  grid.innerHTML = results.map(app => `
    <article class="app-card">
      <div class="card-head">
        <div class="app-logo" style="--logo:${safe(app.color)}">
          ${safe(app.symbol)}
        </div>
        <span class="tag">
          ${app.platform === "android" ? "ANDROID" : "PC SOFTWARE"}
        </span>
      </div>
      <h3>${safe(app.name)}</h3>
      <p>${safe(app.description)}</p>
      <div class="meta">
        <span>${safe(app.device)}</span>
        <span>${safe(app.category.toUpperCase())}</span>
      </div>
      <a class="download" href="${safe(app.url)}"
         target="_blank" rel="noopener noreferrer">
        Official download ↗
      </a>
    </article>
  `).join("");

  if (count) count.textContent = results.length + " items";
  if (empty) empty.hidden = results.length > 0;
  grid.hidden = results.length === 0;
};

document.addEventListener("DOMContentLoaded", () => {
  window.MURUQ.renderCatalog();
});
