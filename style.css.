*{box-sizing:border-box}
:root{color-scheme:dark;--bg:#080d1b;--panel:#11182a;--panel2:#151d32;--text:#f5f7ff;--muted:#9ba8c4;--cyan:#2fe6ef;--pink:#f044a0;--line:rgba(166,190,255,.13)}
html{scroll-behavior:smooth;scroll-padding-top:85px}
body{margin:0;background:radial-gradient(ellipse at 14% 17%,#32165a 0,transparent 34%),radial-gradient(ellipse at 90% 23%,#063c49 0,transparent 31%),var(--bg);color:var(--text);font:15px/1.55 system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}
a{color:inherit;text-decoration:none}
button,input{font:inherit}
.topbar{height:68px;padding:0 clamp(16px,4vw,54px);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:rgba(7,12,26,.88);position:sticky;top:0;z-index:5;backdrop-filter:blur(16px)}
.brand{display:flex;align-items:center;gap:9px;font-weight:900;letter-spacing:.2px}
.brand-mark{display:grid;place-items:center;width:35px;height:35px;border-radius:12px;background:linear-gradient(135deg,#a64dff,#27e8ed);color:white;font-size:20px;box-shadow:0 0 25px #5e45ff42}
.brand-accent{color:#d88dff}
.nav-links{display:flex;gap:24px;color:#c7d2eb;font-size:13px}
.nav-links a:hover{color:var(--cyan)}
.menu-toggle{display:none;background:transparent;color:white;border:1px solid var(--line);border-radius:9px;padding:7px 11px}
.hero{text-align:center;padding:60px 18px 45px;max-width:900px;margin:auto}
.eyebrow{display:inline-block;border:1px solid var(--line);border-radius:30px;padding:7px 13px;color:#d2d9f4;font-size:10px;letter-spacing:2px}
.hero h1{font-size:clamp(39px,7vw,66px);line-height:1.05;letter-spacing:-2px;margin:20px 0}
.hero h1 span{background:linear-gradient(90deg,#31f0e6,#58a9ff,#db70ff);background-clip:text;-webkit-background-clip:text;color:transparent}
.hero p{max-width:620px;margin:0 auto;color:var(--muted);font-size:14px}
.ticker{white-space:nowrap;overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:12px 0;color:#a9b5d1;font-size:10px;letter-spacing:2px;text-align:center;background:#0b1120}
.catalog-section{max-width:1240px;margin:auto;padding:30px clamp(14px,3vw,30px) 55px}
.toolbar{display:flex;gap:18px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:28px}
.search-box{display:flex;align-items:center;gap:8px;min-width:min(100%,340px);flex:1;max-width:480px;border:1px solid #35cde1;border-radius:13px;padding:8px 12px;background:#11172a;box-shadow:0 0 20px #14d8e622}
.search-box input{min-width:0;flex:1;border:0;outline:0;background:transparent;color:white;font-size:13px;padding:3px}
.search-box button{border:0;background:transparent;color:#b6c1db;font-size:23px;cursor:pointer}
.filters{display:flex;gap:8px;flex-wrap:wrap}
.filter,.reset-button{border:1px solid var(--line);border-radius:22px;background:#151c30;color:#dbe3fa;padding:8px 13px;font-size:11px;cursor:pointer}
.filter:hover,.filter.active{background:linear-gradient(100deg,#21dce9,#7bf4d7);color:#07101c;border-color:transparent;font-weight:800}
.section-heading{display:flex;justify-content:space-between;align-items:center;gap:14px;margin:4px 0 18px}
.section-heading h2{font-size:20px;margin:0}
.section-heading h2 span{color:#e8d8ff}
.section-heading p{font-size:11px;color:var(--muted);margin:2px 0}
.reset-button{white-space:nowrap}
.catalog-status{min-height:10px;color:var(--muted);font-size:12px;margin:0 0 10px}
.app-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.app-card{min-width:0;border:1px solid var(--line);border-radius:20px;background:linear-gradient(145deg,#182136,#0e1424);padding:14px;display:flex;flex-direction:column;gap:12px;box-shadow:0 12px 28px #00000012;transition:transform .18s,border-color .18s}
.app-card:hover{transform:translateY(-3px);border-color:#4acddd80}
.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.app-icon{width:48px;height:48px;flex:0 0 48px;display:grid;place-items:center;border-radius:14px;background:linear-gradient(135deg,var(--icon-a,#25dce9),var(--icon-b,#866cff));font-size:25px;font-weight:800;overflow:hidden}
.app-icon img{width:100%;height:100%;object-fit:cover}
.category-name{font-size:9px;letter-spacing:.5px;text-transform:uppercase;color:#8debf1;border:1px solid #4bcbd64d;border-radius:20px;padding:4px 7px}
.app-info h3{font-size:14px;margin:0 0 4px;overflow-wrap:anywhere}
.publisher{font-size:10px;color:#7f91b5;margin-bottom:5px}
.app-description{font-size:11px;color:#aab6d0;line-height:1.55;flex:1}
.card-foot{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto;flex-wrap:wrap}
.price-label{font-size:10px;color:#9fe8c1}
.price-label.paid{color:#ffcf86}
.download-link{display:inline-flex;justify-content:center;align-items:center;gap:5px;border:0;border-radius:10px;padding:10px 12px;background:linear-gradient(90deg,#29e5e9,#60d9e8);color:#07101c;font-size:11px;font-weight:800;text-align:center;flex:1;min-width:110px}
.download-link:hover{filter:brightness(1.08)}
.empty-state{text-align:center;padding:38px 15px;border:1px dashed #4d5b7b;border-radius:18px;color:var(--muted)}
.empty-state h3{color:white;margin:0 0 5px}
.empty-state button,.primary-button{border:0;border-radius:10px;background:var(--cyan);padding:10px 15px;color:#07101c;font-weight:800;cursor:pointer}
[hidden]{display:none!important}
.info-section{border-top:1px solid var(--line);padding:48px 20px 55px;text-align:center;background:#0c1221}
.info-section h2{font-size:clamp(24px,4vw,34px);margin:14px 0 8px}
.info-section>p{max-width:700px;color:var(--muted);margin:0 auto 24px;font-size:13px}
.info-grid{max-width:850px;margin:auto;display:grid;grid-template-columns:repeat(3,1fr);gap:12px;text-align:left}
.info-grid>div{padding:17px;border:1px solid var(--line);border-radius:14px;background:#11192a}
.info-grid b,.info-grid small{display:block}.info-grid b{font-size:13px}.info-grid small{font-size:11px;color:var(--muted);margin-top:5px}
footer{padding:26px 18px;text-align:center;border-top:1px solid var(--line);color:var(--muted);font-size:11px}
.footer-brand{justify-content:center;color:white;font-size:13px}
footer p{margin:12px 0 5px}
footer>a:last-child{color:var(--cyan)}
@media(max-width:900px){.app-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.toolbar{align-items:stretch}.search-box{max-width:none}.filters{justify-content:flex-start}}
@media(max-width:640px){.topbar{height:60px}.menu-toggle{display:block}.nav-links{display:none;position:absolute;top:59px;left:0;right:0;background:#0d1425;padding:16px 20px;border-bottom:1px solid var(--line);flex-direction:column;gap:14px}.nav-links.open{display:flex}.hero{padding:42px 17px 32px}.hero h1{letter-spacing:-1px}.hero p{font-size:12px}.catalog-section{padding-top:22px}.app-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.app-card{padding:11px;border-radius:16px}.app-icon{width:42px;height:42px;flex-basis:42px;font-size:21px}.app-info h3{font-size:13px}.app-description{font-size:10px}.download-link{min-width:100%;padding:9px 7px}.card-foot{align-items:stretch}.section-heading h2{font-size:18px}.info-grid{grid-template-columns:1fr}.filters{gap:6px}.filter{padding:7px 10px}}
@media(max-width:360px){.app-grid{grid-template-columns:1fr}.app-card{min-height:0}.download-link{min-width:0}}
.ceo-section {
  text-align: center;
  padding: 60px 20px;
  background: #f8fafc;
  color: #172033;
}

.ceo-photo {
  width: 220px;
  height: 260px;
  object-fit: cover;
  border-radius: 50%;
  display: block;
  margin: 0 auto 20px;
}
