:root{--bg:#080b12;--panel:#101521;--panel2:#151b2a;--border:#262e41;--text:#f4f6fc;--muted:#9ba5bb;--purple:#ae91ff;--mint:#77f2c0}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}a{color:inherit;text-decoration:none}button,input{font:inherit}.header{height:72px;position:sticky;top:0;z-index:10;display:flex;align-items:center;justify-content:space-between;padding:0 7%;border-bottom:1px solid #1b2130;background:#080b12ed;backdrop-filter:blur(14px)}.logo{display:flex;align-items:center;gap:10px;font-weight:850;font-size:17px;letter-spacing:-.4px;white-space:nowrap}.logo-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:linear-gradient(135deg,var(--purple),var(--mint));color:#10121a;font-size:20px}.accent{color:var(--purple)}nav{display:flex;gap:28px;color:var(--muted);font-size:12px}nav a:hover{color:#fff}.header-cta{padding:10px 14px;border:1px solid var(--border);border-radius:9px;font-size:11px;font-weight:750}.header-cta span{color:var(--mint);margin-left:5px}.hero{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:30px;padding:72px 9% 50px;min-height:450px;background:radial-gradient(ellipse at 80% 40%,#7d5ad01c,transparent 40%),radial-gradient(ellipse at 15% 0%,#3ad4a10d,transparent 38%)}.eyebrow{font-size:10px;font-weight:850;letter-spacing:2px;color:var(--mint)}.pulse{display:inline-block;width:6px;height:6px;background:var(--mint);border-radius:50%;margin:0 8px 1px 0;box-shadow:0 0 12px var(--mint)}h1{font-size:clamp(40px,5vw,64px);letter-spacing:-3px;line-height:1.04;margin:20px 0 15px}h1 span{color:var(--purple)}.hero-content>p{max-width:480px;color:var(--muted);font-size:13px;line-height:1.8}.searchbox{display:flex;align-items:center;gap:10px;max-width:470px;margin-top:25px;padding:8px 12px;border:1px solid #343b51;border-radius:12px;background:#111623}.searchbox>span{font-size:27px;color:var(--purple)}.searchbox input{min-width:0;flex:1;background:transparent;border:0;outline:0;color:white;font-size:12px;padding:9px 0}.searchbox input::placeholder{color:#78839a}.searchbox button{border:0;background:transparent;color:#8e98ae;font-size:22px;cursor:pointer}.trust-line{display:flex;gap:9px;align-items:center;color:#8993a8;font-size:10px;margin-top:15px}.trust-line span{color:var(--mint)}.hero-visual{height:300px;position:relative;display:grid;place-items:center}.ring{position:absolute;border:1px solid #302a4b;border-radius:50%;transform:rotate(-24deg)}.ring-a{width:320px;height:200px}.ring-b{width:235px;height:285px;transform:rotate(32deg);border-color:#1e3434}.main-tile{z-index:1;width:155px;height:175px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;border:1px solid #51476f;border-radius:26px;background:linear-gradient(145deg,#2b2448,#111a28);box-shadow:0 25px 70px #0008;transform:rotate(-7deg)}.main-m{width:75px;height:75px;display:grid;place-items:center;border-radius:22px;background:linear-gradient(140deg,var(--purple),var(--mint));color:#12131a;font-size:44px;font-weight:950}.main-tile small{font-size:8px;letter-spacing:2px;color:#d2c9ee}.float-chip{position:absolute;z-index:2;display:flex;align-items:center;gap:10px;padding:11px 13px;border:1px solid #33394d;border-radius:12px;background:#151a28;box-shadow:0 12px 35px #0006}.chip-one{right:-5px;top:35px}.chip-two{left:-2px;bottom:30px}.chip-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;font-size:19px}.purple{color:var(--purple);background:#302747}.mint{color:var(--mint);background:#173a32}.float-chip b,.float-chip small{display:block}.float-chip b{font-size:10px}.float-chip small{font-size:9px;color:var(--muted);margin-top:4px}.quick-links{display:grid;grid-template-columns:repeat(3,1fr);margin:0 9%;border:1px solid var(--border);border-radius:14px;overflow:hidden;background:#0e121c}.quick-links>a{display:flex;align-items:center;gap:12px;padding:17px;border-right:1px solid var(--border)}.quick-links>a:last-child{border:0}.quick-icon{display:grid;place-items:center;width:39px;height:39px;border-radius:11px;background:#2b2444;color:var(--purple);font-size:20px}.quick-icon.game{background:#17392f;color:var(--mint)}.quick-icon.pc{background:#1c2d49;color:#83b7ff}.quick-links b,.quick-links small{display:block}.quick-links b{font-size:11px}.quick-links small{font-size:9px;color:var(--muted);margin-top:4px}.quick-links i{font-style:normal;margin-left:auto;color:#737e96}.catalog{padding:78px 9% 70px}.section-title{display:flex;justify-content:space-between;align-items:end}.section-title h2,.notice h2{font-size:31px;letter-spacing:-1px;margin:9px 0}.section-title p{font-size:12px;color:var(--muted);margin:0}.count{font-size:11px;color:var(--muted);padding-bottom:5px}.filters{display:flex;flex-wrap:wrap;gap:8px;margin:25px 0}.filter{padding:10px 14px;border-radius:8px;border:1px solid var(--border);background:#101521;color:#a4aec2;font-size:10px;cursor:pointer}.filter:hover{border-color:#65548c}.filter.active{background:var(--purple);border-color:var(--purple);color:#17121f;font-weight:850}.app-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}.app-card{min-width:0;padding:16px;border:1px solid var(--border);border-radius:13px;background:linear-gradient(145deg,#131927,#0e121c);transition:.2s}.app-card:hover{transform:translateY(-3px);border-color:#5c4c81}.card-head{display:flex;justify-content:space-between;align-items:center;gap:7px}.app-logo{display:grid;place-items:center;width:46px;height:46px;border-radius:13px;background:var(--logo,#2d2943);font-size:21px;font-weight:900;border:1px solid #ffffff13}.tag{font-size:8px;color:var(--mint);border:1px solid #285245;border-radius:5px;padding:5px 6px;white-space:nowrap}.app-card h3{font-size:14px;margin:16px 0 7px}.app-card p{font-size:10px;line-height:1.7;color:var(--muted);min-height:53px;margin:0}.meta{display:flex;justify-content:space-between;gap:5px;margin:14px 0;color:#7f8aa2;font-size:8px}.download{display:block;text-align:center;padding:10px 6px;background:#1b2232;border:1px solid #343d53;border-radius:8px;font-size:10px;font-weight:800}.download:hover{background:var(--mint);color:#0b1512;border-color:var(--mint)}.empty{text-align:center;padding:45px 10px;color:var(--muted)}.empty>div{font-size:35px;color:var(--purple)}.empty h3{color:#fff}.notice{display:flex;align-items:center;gap:20px;margin:0 9% 70px;padding:25px;border:1px solid #303249;border-radius:15px;background:radial-gradient(ellipse at 0 50%,#292341,transparent 60%),#101521}.notice-icon{flex:0 0 50px;height:50px;display:grid;place-items:center;background:#173a32;border-radius:13px;color:var(--mint);font-size:27px}.notice h2{font-size:21px}.notice p{font-size:11px;line-height:1.8;color:var(--muted);margin:0;max-width:780px}footer{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:24px 7%;border-top:1px solid #1c2230}footer .logo{font-size:13px}footer .logo-mark{width:29px;height:29px;font-size:16px}footer p,footer>span{font-size:9px;color:#7c869b}
@media(max-width:900px){.header{padding:0 5%}.hero,.catalog{padding-left:6%;padding-right:6%}.quick-links,.notice{margin-left:6%;margin-right:6%}.app-grid{grid-template-columns:repeat(2,minmax(0,1fr))}nav{gap:14px}}
@media(max-width:620px){.header{height:63px}.header nav{display:none}.header-cta{font-size:10px;padding:9px}.hero{display:block;padding-top:48px}.hero-visual{height:265px;margin-top:15px}.main-tile{width:135px;height:150px}.main-m{width:65px;height:65px}.ring-a{width:275px;height:170px}.ring-b{width:205px;height:245px}.chip-one{right:0;top:20px}.chip-two{left:0;bottom:20px}.quick-links{grid-template-columns:1fr}.quick-links>a{border-right:0;border-bottom:1px solid var(--border);padding:13px}.quick-links>a:last-child{border-bottom:0}.catalog{padding-top:55px}.section-title h2{font-size:27px}.app-grid{gap:9px}.app-card{padding:11px}.app-logo{width:40px;height:40px}.tag{font-size:7px;padding:4px}.app-card h3{font-size:12px}.app-card p{font-size:9px;min-height:65px}.meta{flex-direction:column}.notice{padding:18px;align-items:flex-start;gap:12px}.notice-icon{flex-basis:40px;height:40px}.notice h2{font-size:19px}footer{flex-wrap:wrap}footer p{order:3;flex-basis:100%;margin:0}}
