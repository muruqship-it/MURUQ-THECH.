
:root {
  --bg: #080b12;
  --panel: #101621;
  --panel-hover: #151e2c;
  --text: #f4f7fb;
  --muted: #929db0;
  --line: #222c3b;
  --blue: #5485ff;
  --cyan: #50e0d0;
  --radius: 20px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  background:
    radial-gradient(ellipse at 75% 0%, #15234a 0, transparent 34%),
    var(--bg);
  color: var(--text);
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

.header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 15px 6%;
  background: rgba(8, 11, 18, .88);
  border-bottom: 1px solid rgba(255,255,255,.07);
  backdrop-filter: blur(18px);
}

.logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 17px;
  font-weight: 850;
  letter-spacing: -.5px;
  white-space: nowrap;
}

.logo-mark {
  display: grid;
  place-items: center;
  width: 37px;
  height: 37px;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--blue), #7655ef);
  box-shadow: 0 5px 22px #5485ff35;
  color: white;
  font-size: 21px;
}

.accent {
  color: var(--cyan);
}

.nav {
  display: flex;
  align-items: center;
  gap: 28px;
}

.nav a {
  color: var(--muted);
  font-size: 13px;
  transition: color .2s;
}

.nav a:hover {
  color: white;
}

.header-cta {
  padding: 10px 16px;
  border: 1px solid #33466e;
  border-radius: 12px;
  background: #15213a;
  color: #dce6ff;
  font-size: 13px;
  font-weight: 750;
}

.hero {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  align-items: center;
  gap: 35px;
  max-width: 1200px;
  min-height: 490px;
  margin: auto;
  padding: 65px 6% 50px;
}

.hero-content {
  max-width: 610px;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #8fa9ff;
  font-size: 11px;
  font-weight: 850;
  letter-spacing: 2px;
}

.pulse {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--cyan);
  box-shadow: 0 0 13px var(--cyan);
}

h1 {
  margin: 22px 0 16px;
  font-size: clamp(42px, 5.3vw, 67px);
  line-height: 1.08;
  letter-spacing: -3px;
}

h1 span {
  color: transparent;
  background: linear-gradient(90deg, #69a1ff, #50e0d0);
  background-clip: text;
  -webkit-background-clip: text;
}

.hero-content > p {
  max-width: 500px;
  color: var(--muted);
  font-size: 15px;
}

.searchbox {
  display: flex;
  align-items: center;
  gap: 12px;
  max-width: 500px;
  margin-top: 26px;
  padding: 6px 12px 6px 17px;
  border: 1px solid #303c50;
  border-radius: 15px;
  background: #111824;
  transition: border-color .2s, box-shadow .2s;
}

.searchbox:focus-within {
  border-color: var(--blue);
  box-shadow: 0 0 0 3px #5485ff20;
}

.searchbox > span {
  color: #8da9ff;
  font-size: 27px;
}

.searchbox input {
  width: 100%;
  min-width: 0;
  padding: 11px 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: white;
  font-size: 13px;
}

.searchbox input::placeholder {
  color: #748197;
}

.searchbox button {
  border: 0;
  background: transparent;
  color: #9ca9bd;
  font-size: 23px;
  cursor: pointer;
}

.trust-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 9px;
  margin-top: 17px;
  color: var(--muted);
  font-size: 11px;
}

.trust-line span {
  color: var(--cyan);
}

.hero-visual {
  position: relative;
  display: grid;
  place-items: center;
  min-height: 330px;
  overflow: hidden;
}

.ring {
  position: absolute;
  border: 1px solid #5c83ef24;
  border-radius: 50%;
}

.ring-a {
  width: 290px;
  height: 290px;
}

.ring-b {
  width: 220px;
  height: 220px;
}

.main-tile {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 175px;
  height: 190px;
  border: 1px solid #a2baff3d;
  border-radius: 30px;
  background: linear-gradient(145deg, #263e73, #101725 75%);
  box-shadow: 0 20px 80px #426ff52b;
  transform: rotate(-5deg);
}

.main-m {
  display: grid;
  place-items: center;
  width: 92px;
  height: 92px;
  margin-bottom: 12px;
  border-radius: 25px;
  background: linear-gradient(135deg, #79a5ff, #6155ee);
  color: white;
  font-size: 60px;
  font-weight: 900;
}

.main-tile small {
  font-size: 11px;
  font-weight: 850;
  letter-spacing: 1px;
}

.main-tile > span {
  color: #8ea8e8;
  font-size: 8px;
  letter-spacing: 2px;
}

.float-chip {
  position: absolute;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px;
  border: 1px solid #354157;
  border-radius: 15px;
  background: #141d2b;
  box-shadow: 0 12px 35px #0005;
}

.chip-one {
  top: 45px;
  left: 0;
}

.chip-two {
  right: 0;
  bottom: 40px;
}

.chip-icon {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 11px;
  font-size: 20px;
}

.purple {
  background: #5b43a6;
}

.mint {
  background: #176e67;
}

.float-chip b,
.float-chip small {
  display: block;
}

.float-chip b {
  font-size: 11px;
}

.float-chip small {
  color: var(--muted);
  font-size: 9px;
}

.quick-links {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  max-width: 1080px;
  margin: 0 auto;
  padding: 0 6%;
}

.quick-links > a {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 17px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: #101621b8;
  transition: transform .2s, border-color .2s, background .2s;
}

.quick-links > a:hover {
  transform: translateY(-3px);
  border-color: #4b6fba;
  background: var(--panel-hover);
}

.quick-icon {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  flex-shrink: 0;
  border-radius: 12px;
  background: #24345a;
  color: #a8c0ff;
  font-size: 20px;
}

.quick-icon.game {
  background: #382753;
  color: #d3b3ff;
}

.quick-icon.pc {
  background: #17443e;
  color: #84f0d8;
}

.quick-links b,
.quick-links small {
  display: block;
}

.quick-links b {
  font-size: 12px;
}

.quick-links small {
  color: var(--muted);
  font-size: 10px;
}

.quick-links i {
  margin-left: auto;
  color: #8ca7ed;
  font-style: normal;
}

.catalog {
  max-width: 1200px;
  margin: auto;
  padding: 85px 6% 55px;
}

.section-title {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
}

.section-title h2 {
  margin: 9px 0 2px;
  font-size: 30px;
  letter-spacing: -1px;
}

.section-title p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.count {
  padding: 7px 11px;
  border: 1px solid var(--line);
  border-radius: 10px;
  color: #c5d4f6;
  font-size: 11px;
  white-space: nowrap;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin: 26px 0;
}

.filter {
  padding: 9px 16px;
  border: 1px solid #273144;
  border-radius: 11px;
  background: #101621;
  color: #a9b4c7;
  font-size: 12px;
  cursor: pointer;
  transition: .2s;
}

.filter:hover {
  border-color: #5978c6;
  color: white;
}

.filter.active {
  border-color: #6287ff;
  background: linear-gradient(120deg, #3158c5, #5543a4);
  color: white;
}

.app-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 17px;
}

.app-card {
  min-width: 0;
  padding: 20px;
  overflow: hidden;
  border: 1px solid #242f41;
  border-radius: var(--radius);
  background: linear-gradient(145deg, #121a27, #0e141e);
  transition: transform .2s, border-color .2s, box-shadow .2s;
}

.app-card:hover {
  transform: translateY(-4px);
  border-color: #526ca5;
  box-shadow: 0 15px 40px #0003;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 17px;
}

.app-logo {
  display: grid;
  place-items: center;
  width: 53px;
  height: 53px;
  flex-shrink: 0;
  border-radius: 16px;
  background: var(--logo, #31466b);
  color: white;
  font-size: 25px;
  font-weight: 850;
  box-shadow: inset 0 0 0 1px #ffffff20;
}

.tag {
  padding: 5px 8px;
  border: 1px solid #303b50;
  border-radius: 7px;
  color: #9db6f8;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .6px;
}

.app-card h3 {
  margin: 0 0 8px;
  font-size: 17px;
  letter-spacing: -.3px;
  overflow-wrap: anywhere;
}

.app-card > p {
  min-height: 60px;
  margin: 0;
  color: var(--muted);
  font-size: 12px;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8px;
  margin: 18px 0;
  color: #8998b0;
  font-size: 10px;
}

.download {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 11px;
  border: 1px solid #405a94;
  border-radius: 11px;
  background: #1a2a49;
  color: #dce7ff;
  font-size: 12px;
  font-weight: 750;
  transition: background .2s;
}

.download:hover {
  background: #2a4270;
}

.empty {
  padding: 45px 15px;
  text-align: center;
  color: var(--muted);
}

.empty > div {
  font-size: 35px;
}

.empty h3 {
  margin: 5px 0;
  color: var(--text);
}

.notice {
  display: flex;
  align-items: flex-start;
  gap: 17px;
  max-width: 1080px;
  margin: 10px auto 70px;
  padding: 23px;
  border: 1px solid #26384a;
  border-radius: 18px;
  background: #101923;
}

.notice-icon {
  display: grid;
  place-items: center;
  width: 43px;
  height: 43px;
  flex-shrink: 0;
  border-radius: 12px;
  background: #17463f;
  color: #85f2d8;
  font-size: 23px;
}

.notice h2 {
  margin: 0 0 4px;
  font-size: 15px;
}

.notice p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
}

footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 25px 6%;
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-size: 11px;
}

footer p {
  margin: 0;
}

[hidden] {
  display: none !important;
}

@media (max-width: 800px) {
  .header {
    padding: 12px 5%;
  }

  .nav {
    gap: 13px;
  }

  .nav a {
    font-size: 11px;
  }

  .hero {
    grid-template-columns: 1fr;
    gap: 5px;
    padding: 55px 6% 35px;
  }

  .hero-visual {
    min-height: 300px;
  }

  .quick-links {
    padding: 0 5%;
    gap: 9px;
  }

  .quick-links > a {
    padding: 12px 9px;
    gap: 8px;
  }

  .quick-icon {
    width: 34px;
    height: 34px;
  }

  .app-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .app-card {
    padding: 15px;
  }

  .notice {
    margin-right: 5%;
    margin-left: 5%;
  }
}

@media (max-width: 520px) {
  .header {
    gap: 8px;
  }

  .logo {
    gap: 7px;
    font-size: 13px;
  }

  .logo-mark {
    width: 32px;
    height: 32px;
    font-size: 18px;
  }

  .nav {
    gap: 10px;
  }

  .nav a {
    font-size: 10px;
  }

  .header-cta {
    padding: 8px 9px;
    font-size: 11px;
  }

  h1 {
    font-size: 44px;
    letter-spacing: -2px;
  }

  .hero-visual {
    min-height: 280px;
  }

  .main-tile {
    width: 150px;
    height: 170px;
  }

  .main-m {
    width: 78px;
    height: 78px;
    font-size: 50px;
  }

  .chip-one {
    left: 0;
  }

  .chip-two {
    right: 0;
  }

  .float-chip {
    padding: 9px;
  }

  .float-chip b {
    font-size: 10px;
  }

  .float-chip small {
    font-size: 8px;
  }

  .quick-links {
    grid-template-columns: 1fr;
  }

  .quick-links > a {
    padding: 13px;
  }

  .catalog {
    padding: 65px 5% 40px;
  }

  .section-title h2 {
    font-size: 25px;
  }

  .filters {
    gap: 7px;
  }

  .filter {
    padding: 8px 11px;
    font-size: 11px;
  }

  .app-grid {
    grid-template-columns: 1fr;
  }

  .app-card {
    padding: 19px;
  }

  .app-card > p {
    min-height: 0;
  }

  footer {
    flex-direction: column;
    align-items: flex-start;
  }
}
