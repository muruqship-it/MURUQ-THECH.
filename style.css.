
:root {
  --bg: #0b0b18;
  --panel: #131326;
  --panel-light: #1b1b35;
  --text: #f5f5ff;
  --muted: #aaaac5;
  --accent: #7c5cff;
  --accent-2: #22d3ee;
  --border: rgba(255,255,255,.1);
  --radius: 20px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 14px 6%;
  background: rgba(11,11,24,.94);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(16px);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  flex-shrink: 0;
}

.logo {
  display: grid;
  place-items: center;
  width: 45px;
  height: 45px;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--accent), #4c36c9);
  color: white;
  font-size: 25px;
  font-weight: 900;
}

.brand b,
.brand small {
  display: block;
}

.brand b {
  font-size: 16px;
  letter-spacing: 1px;
}

.brand small {
  color: var(--muted);
  font-size: 9px;
  letter-spacing: 2px;
}

#nav {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 17px;
}

#nav a {
  color: var(--muted);
  font-size: 13px;
  transition: color .2s;
}

#nav a:hover {
  color: var(--accent-2);
}

.menu-btn {
  display: none;
  padding: 8px 12px;
  color: white;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 10px;
  cursor: pointer;
}

.hero {
  min-height: 470px;
  padding: 85px 8%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 80% 45%, rgba(124,92,255,.2), transparent 42%),
    radial-gradient(ellipse at 10% 0%, rgba(34,211,238,.08), transparent 40%);
}

.hero-copy {
  max-width: 620px;
}

.eyebrow {
  display: inline-block;
  color: var(--accent-2);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
}

.hero h1 {
  margin: 20px 0;
  font-size: clamp(38px, 6vw, 68px);
  line-height: 1.08;
  letter-spacing: -2px;
}

.hero h1 span {
  color: var(--accent-2);
}

.hero p,
.section-head p,
.section > p {
  color: var(--muted);
}

.hero p {
  max-width: 520px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 25px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 10px 17px;
  color: var(--text);
  background: var(--panel-light);
  border: 1px solid var(--border);
  border-radius: 12px;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: transform .2s, border-color .2s, background .2s;
}

.btn:hover {
  transform: translateY(-2px);
  border-color: var(--accent);
}

.btn.primary {
  background: linear-gradient(135deg, var(--accent), #6044db);
  border-color: transparent;
}

.orbit {
  position: relative;
  display: grid;
  place-items: center;
  flex: 0 0 250px;
  width: 250px;
  height: 250px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124,92,255,.25), transparent 68%);
  font-size: 44px;
}

.orbit-ring {
  position: absolute;
  inset: 12px;
  border: 1px solid rgba(124,92,255,.55);
  border-radius: 50%;
}

.orbit span:not(:first-of-type) {
  position: absolute;
  display: grid;
  place-items: center;
  width: 56px;
  height: 56px;
  background: var(--panel-light);
  border: 1px solid var(--border);
  border-radius: 17px;
  font-size: 25px;
}

.orbit span:nth-of-type(1) {
  transform: translateY(-78px);
}

.orbit span:nth-of-type(2) {
  transform: translate(78px, 0);
}

.orbit span:nth-of-type(3) {
  transform: translateY(78px);
}

.orbit span:nth-of-type(4) {
  transform: translate(-78px, 0);
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  padding: 0 8%;
}

.stats > div {
  padding: 20px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 16px;
  text-align: center;
}

.stats b,
.stats small {
  display: block;
}

.stats b {
  font-size: 18px;
}

.stats small {
  color: var(--muted);
  font-size: 12px;
}

.section {
  padding: 75px 8%;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 25px;
}

.section h2 {
  margin: 8px 0;
  font-size: clamp(27px, 4vw, 38px);
  line-height: 1.2;
}

.section-head p {
  margin: 8px 0 0;
}

.count,
.tag {
  display: inline-block;
  padding: 5px 10px;
  color: var(--accent-2);
  background: rgba(34,211,238,.09);
  border: 1px solid rgba(34,211,238,.18);
  border-radius: 30px;
  font-size: 11px;
}

.searchbar {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 22px 0 15px;
  padding: 0 16px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
}

.searchbar span {
  color: var(--accent-2);
  font-size: 26px;
}

.searchbar input {
  width: 100%;
  min-width: 0;
  padding: 15px 0;
  color: var(--text);
  background: transparent;
  border: 0;
  outline: none;
}

.searchbar input::placeholder {
  color: #8585a5;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-bottom: 25px;
}

.filter {
  padding: 8px 15px;
  color: var(--muted);
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 30px;
  cursor: pointer;
}

.filter:hover,
.filter.active {
  color: white;
  background: var(--accent);
  border-color: var(--accent);
}

.cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.card {
  min-width: 0;
  padding: 23px;
  background: linear-gradient(145deg, var(--panel), #101020);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  transition: transform .2s, border-color .2s;
}

.card:hover {
  transform: translateY(-4px);
  border-color: rgba(124,92,255,.65);
}

.app-icon {
  display: grid;
  place-items: center;
  width: 55px;
  height: 55px;
  margin-bottom: 15px;
  background: var(--panel-light);
  border: 1px solid var(--border);
  border-radius: 16px;
  font-size: 28px;
}

.card h3 {
  margin: 12px 0 8px;
  font-size: 19px;
  overflow-wrap: anywhere;
}

.card p {
  color: var(--muted);
  font-size: 13px;
}

.card .btn {
  margin-top: 10px;
}

.hidden {
  display: none !important;
}

.empty {
  padding: 25px;
  color: var(--muted);
  text-align: center;
}

.windows {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 35px;
  background:
    radial-gradient(ellipse at 90% 50%, rgba(34,211,238,.1), transparent 45%),
    var(--panel);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.windows > div:first-child {
  max-width: 720px;
}

.windows .btn {
  margin: 10px 8px 5px 0;
}

.windows-icon {
  color: var(--accent-2);
  font-size: 130px;
  line-height: 1;
}

.note {
  color: var(--muted);
  font-size: 12px;
}

.about {
  text-align: center;
}

.about > p {
  max-width: 720px;
  margin: 18px auto 30px;
  color: var(--muted);
}

.site-welcome {
  color: var(--accent-2);
  letter-spacing: 4px;
  font-size: 13px;
}

.about-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 15px;
  margin-top: 30px;
  text-align: left;
}

.about-grid > div {
  padding: 20px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 15px;
}

.about-grid b,
.about-grid small {
  display: block;
}

.about-grid small {
  margin-top: 6px;
  color: var(--muted);
}

.contact {
  text-align: center;
  background:
    radial-gradient(ellipse at 50% 100%, rgba(124,92,255,.16), transparent 60%);
}

.contact p {
  color: var(--muted);
}

.contact .btn {
  margin-top: 12px;
}

.privacy {
  padding-top: 35px;
  padding-bottom: 50px;
  border-top: 1px solid var(--border);
}

.privacy p {
  max-width: 850px;
  color: var(--muted);
}

footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 30px 8%;
  background: #080811;
  border-top: 1px solid var(--border);
}

footer p,
footer > a:last-child {
  color: var(--muted);
  font-size: 12px;
}

footer > a:last-child:hover {
  color: var(--accent-2);
}

@media (max-width: 1000px) {
  .topbar {
    padding-right: 5%;
    padding-left: 5%;
  }

  #nav {
    gap: 11px;
  }

  #nav a {
    font-size: 12px;
  }

  .section,
  .hero {
    padding-right: 6%;
    padding-left: 6%;
  }

  .cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 700px) {
  .topbar {
    flex-wrap: wrap;
    padding: 12px 5%;
  }

  .menu-btn {
    display: block;
  }

  #nav {
    display: none;
    width: 100%;
    align-items: stretch;
    flex-direction: column;
    gap: 0;
    padding-top: 8px;
  }

  #nav.open {
    display: flex;
  }

  #nav a {
    padding: 10px 5px;
    border-top: 1px solid var(--border);
    font-size: 14px;
  }

  .hero {
    min-height: auto;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 55px;
    padding-bottom: 45px;
  }

  .hero h1 {
    letter-spacing: -1px;
  }

  .orbit {
    align-self: center;
    flex-basis: 210px;
    width: 210px;
    height: 210px;
    margin-top: 10px;
  }

  .orbit span:nth-of-type(1) {
    transform: translateY(-65px);
  }

  .orbit span:nth-of-type(2) {
    transform: translate(65px, 0);
  }

  .orbit span:nth-of-type(3) {
    transform: translateY(65px);
  }

  .orbit span:nth-of-type(4) {
    transform: translate(-65px, 0);
  }

  .stats {
    grid-template-columns: 1fr;
    padding-right: 5%;
    padding-left: 5%;
  }

  .section {
    padding: 55px 5%;
  }

  .section-head {
    align-items: flex-start;
    flex-direction: column;
  }

  .cards,
  .about-grid {
    grid-template-columns: 1fr;
  }

  .windows {
    flex-direction: column;
    align-items: flex-start;
  }

  .windows-icon {
    align-self: center;
    font-size: 90px;
  }

  footer {
    flex-direction: column;
    align-items: flex-start;
    padding-right: 5%;
    padding-left: 5%;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
}
