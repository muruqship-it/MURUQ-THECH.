
* {
  box-sizing: border-box;
}

:root {
  color-scheme: dark;
  --bg: #080b12;
  --panel: #111827;
  --border: #263246;
  --text: #f4f7ff;
  --muted: #a0abc0;
  --accent: #9a7bff;
  --mint: #62efc1;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

button, input {
  font: inherit;
}

button, a {
  -webkit-tap-highlight-color: transparent;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 20px 6%;
  border-bottom: 1px solid var(--border);
  flex-wrap: wrap;
}

.logo {
  font-size: 21px;
  font-weight: 900;
  letter-spacing: -1px;
}

.logo span {
  color: var(--accent);
}

nav {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

nav a, .explore {
  color: var(--muted);
  font-size: 14px;
}

nav a:hover, .explore:hover {
  color: var(--mint);
}

.explore {
  padding: 9px 15px;
  border: 1px solid var(--border);
  border-radius: 10px;
}

.hero {
  max-width: 950px;
  margin: auto;
  padding: 80px 22px 65px;
  text-align: center;
}

.eyebrow {
  color: var(--mint);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
}

h1 {
  margin: 20px 0;
  font-size: clamp(36px, 7vw, 65px);
  line-height: 1.12;
  letter-spacing: -2px;
}

h1 span {
  color: var(--accent);
}

.hero > p, .section-title p, .notice p, footer p {
  color: var(--muted);
}

.hero > p {
  max-width: 600px;
  margin: 0 auto 28px;
}

.searchbox {
  display: flex;
  align-items: center;
  gap: 12px;
  max-width: 590px;
  margin: 28px auto 0;
  padding: 8px 14px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
}

.searchbox > span {
  color: var(--mint);
  font-size: 25px;
}

.searchbox input {
  width: 100%;
  min-width: 0;
  padding: 10px 0;
  color: var(--text);
  background: transparent;
  border: 0;
  outline: none;
}

.searchbox button {
  color: var(--muted);
  background: transparent;
  border: 0;
  font-size: 25px;
  cursor: pointer;
}

.catalog {
  max-width: 1150px;
  margin: auto;
  padding: 25px 22px 65px;
  scroll-margin-top: 20px;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 25px;
}

h2 {
  margin: 5px 0;
  font-size: 28px;
}

.section-title p {
  margin: 5px 0;
}

.count {
  padding: 7px 12px;
  color: var(--mint);
  background: #10231f;
  border-radius: 20px;
  white-space: nowrap;
  font-size: 13px;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-bottom: 25px;
}

.filter {
  padding: 9px 15px;
  color: var(--muted);
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 10px;
  cursor: pointer;
}

.filter:hover, .filter.active {
  color: #fff;
  background: #302354;
  border-color: var(--accent);
}

.app-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 17px;
}

.app-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 19px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 16px;
  transition: border-color .2s, transform .2s;
}

.app-card:hover {
  border-color: var(--accent);
  transform: translateY(-3px);
}

.app-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.app-icon {
  display: grid;
  width: 48px;
  height: 48px;
  place-items: center;
  background: #27213e;
  border-radius: 13px;
  font-size: 24px;
}

.app-category {
  color: var(--mint);
  font-size: 11px;
}

.app-name {
  margin: 18px 0 5px;
  font-size: 19px;
}

.app-description {
  flex: 1;
  margin: 0 0 20px;
  color: var(--muted);
  font-size: 14px;
}

.download {
  display: block;
  padding: 11px;
  color: #090c13;
  background: var(--mint);
  border-radius: 9px;
  text-align: center;
  font-weight: 800;
  font-size: 13px;
}

.download:hover {
  background: #a3ffdf;
}

.empty {
  padding: 35px 10px;
  text-align: center;
}

.empty p {
  color: var(--muted);
}

.notice {
  margin: 0 6% 60px;
  padding: 25px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 15px;
}

.notice h2 {
  font-size: 21px;
}

.notice p {
  margin-bottom: 0;
}

footer {
  padding: 30px 6%;
  border-top: 1px solid var(--border);
  text-align: center;
}

footer p {
  font-size: 13px;
}

@media (max-width: 800px) {
  .app-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .header {
    padding: 17px 5%;
  }

  nav {
    order: 3;
    width: 100%;
    justify-content: center;
  }

  .hero {
    padding-top: 55px;
  }
}

@media (max-width: 520px) {
  .app-grid {
    grid-template-columns: 1fr;
  }

  .section-title {
    align-items: flex-start;
  }

  h2 {
    font-size: 24px;
  }

  .notice {
    margin-left: 5%;
    margin-right: 5%;
  }
}
